{
  "name": "transaction-webhook-service",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook ingestion service: acks fast (202), processes transactions reliably in the background.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "migrate": "node scripts/migrate.js",
    "db:check": "node scripts/check-database.js",
    "smoke": "node scripts/smoke-test.js",
    "load-test": "node scripts/load-test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1153.0",
    "@codegenie/serverless-express": "^5.0.0",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
