# Copy to .env for local development. NEVER commit real values.

NODE_ENV=development
LOG_LEVEL=info

# Runtime connection (Lambda uses the Supabase *transaction pooler*, port 6543).
# Local docker-compose Postgres:
DATABASE_URL=postgres://postgres:postgres@localhost:5433/transactions
# Migrations use a direct/session connection (Supabase direct, port 5432). Falls back to DATABASE_URL if unset.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5433/transactions

# "require" for Supabase, "disable" for local docker Postgres.
DB_SSL=disable
# Keep at 1 per Lambda container (see docs/design-and-plan.md, section 8).
DB_POOL_MAX=1

# "memory" for local runs (not durable); "sqs" in AWS, which also requires QUEUE_URL.
QUEUE_DRIVER=memory
# QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/<account-id>/<queue-name>
PROCESS_DELAY_SECONDS=30
# Optional: when set, POST /v1/webhooks/transactions requires X-Webhook-Signature (hex HMAC-SHA256 of the raw body).
# WEBHOOK_SECRET=change-me-please
# Must match the SQS redrive policy maxReceiveCount.
MAX_RECEIVE_COUNT=5
REPAIR_GRACE_SECONDS=10
RECONCILE_AFTER_SECONDS=120
RECONCILE_RETRYING_AFTER_SECONDS=1800
RECONCILE_BATCH_SIZE=100
